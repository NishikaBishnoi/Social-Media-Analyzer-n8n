        {
            "parameters": {
                "jsCode": "const videos = $input.all().map(i => i.json);\n\nconst average = list => list.length\n  ? list.reduce((sum, n) => sum + n, 0) / list.length\n  : 0;\n\n// Sort all videos from best to worst engagement\nconst ranked = [...videos].sort((a, b) => b.engagement_rate - a.engagement_rate);\n\n// Group engagement rates by the weekday each video was published\nconst byDay = {};\nvideos.forEach(v => {\n  const day = new Date(v.published_at)\n    .toLocaleDateString('en-US', { weekday: 'long' });\n  if (!byDay[day]) byDay[day] = [];\n  byDay[day].push(v.engagement_rate);\n});\n\nconst days = Object.entries(byDay)\n  .map(([day, rates]) => ({\n    day,\n    avg_engagement: Number(average(rates).toFixed(2)),\n    videos: rates.length\n  }))\n  .sort((a, b) => b.avg_engagement - a.avg_engagement);\n\nconst pick = v => ({\n  title: v.title,\n  views: v.views,\n  engagement_rate: v.engagement_rate\n});\n\nreturn [{ json: {\n  total_videos: videos.length,\n  total_views: videos.reduce((sum, v) => sum + v.views, 0),\n  avg_engagement: Number(average(videos.map(v => v.engagement_rate)).toFixed(2)),\n  top3: ranked.slice(0, 3).map(pick),\n  bottom3: ranked.slice(-3).map(pick),\n  best_day: days[0],\n  by_day: days\n}}];"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
